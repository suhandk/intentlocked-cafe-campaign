# Text, Seedream images and visual QA use the same server-side OpenRouter key.
# Copy to .env. Never commit a populated key. Mock is network-isolated.
INFERENCE_MODE=mock
INFERENCE_API_KEY=
# Optional direct OpenAI adapter only; leave blank for the selected OpenRouter profile.
OPENAI_API_KEY=
IMAGE_PROVIDER=gateway
ENABLE_VISION=true
LOCAL_VIDEO_ENABLED=true
NANOBANANA_API_KEY=
OLLAMA_API_KEY=
INFERENCE_BASE_URL=https://openrouter.ai/api/v1
VIDEO_ENTITLEMENT_VERIFIED=false
# Exact public output CDN host(s); no URLs or wildcard/private hosts.
MEDIA_ALLOWED_HOSTS=[]
# Prices unknown until verified; optional per-million text and per-output image prices.
TEXT_INPUT_PRICE_PER_MILLION=
TEXT_OUTPUT_PRICE_PER_MILLION=
IMAGE_PRICE_PER_OUTPUT=
TEXT_RPM=8
IMAGE_RPM=8
VIDEO_RPM=1
STRUCTURED_STRATEGY=json
DATABASE_PATH=data/campaigns.sqlite3
ASSET_PATH=data/assets
FRONTEND_ORIGIN=http://127.0.0.1:3000
RENDER_ORIGIN=http://127.0.0.1:8000
# No TODAY_OVERRIDE: normal operation must use the real clock.
DEMO_FAST=false

# Optional website publishing. Private single-owner profile; credentials require HTTPS.
WEBSITE_PUBLISH_ENABLED=false
WEBSITE_OWNER_ID=local-owner
# Base64-encoded 32-byte encryption key, supplied privately by the server operator.
# Blank disables remembering tokens; generation and zip export do not need this key.
WEBSITE_TOKEN_KEY=

# Website layout only; separate from campaign inference and owner Netlify tokens.
WEBSITE_MODEL=qwen/qwen3-coder-flash
WEBSITE_AI_MODE=mock
OPENROUTER_API_KEY=

# Optional delivery: separate from inference, export and WhatsApp draft links.
# Set a random private owner authorization (at least 32 characters) before enabling.
META_ENABLED=false
META_MODE=mock
# Candidate pin; confirm current support/retirement in official Meta docs before live enablement.
META_GRAPH_VERSION=v25.0
META_VERIFIED_PLATFORMS=[]
META_OWNER_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_BUSINESS_ID=
META_WHATSAPP_TOKEN=
META_FACEBOOK_PAGE_ID=
META_FACEBOOK_TOKEN=
# Instagram uses Facebook Login, not Instagram Login tokens.
META_INSTAGRAM_ACCOUNT_ID=
META_INSTAGRAM_TOKEN=
# Public HTTPS origin for only /api/meta/media/* and /api/meta/webhook.
META_PUBLIC_ORIGIN=
META_REQUEST_TIMEOUT=20
META_MAX_ATTEMPTS=3
META_POLL_LIMIT=6
# Static parameter-free template mapping: "name:language" -> verified exact body SHA256.
META_WHATSAPP_TEMPLATES={}

TEXT_MODEL=openai/gpt-4o-mini
IMAGE_MODEL=bytedance-seed/seedream-5-0-flash
ENABLE_VIDEO=false
VIDEO_MODEL=disabled
